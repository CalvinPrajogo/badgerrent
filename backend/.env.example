# PostgreSQL Database Configuration
# Copy this file to .env and update with your local settings

DB_HOST=localhost
DB_PORT=5432
DB_NAME=badgerrent
DB_USER=your_mac_username_here
DB_PASSWORD=

# Instructions for teammates:
# 1. Copy this file: cp .env.example .env
# 2. Update DB_USER to your Mac username
# 3. Make sure PostgreSQL is installed and running
# 4. Create the badgerrent database: createdb badgerrent
# 5. Run the database migration scripts to set up tables
